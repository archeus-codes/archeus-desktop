<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<TitledPane text="Button Activator" expanded="false"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="codes.archeus.desktop.controller.ButtonActivatorController">

    <VBox spacing="10">
        <padding>
            <Insets top="8" right="4" bottom="8" left="4"/>
        </padding>

        <!-- Controller pad -->
        <HBox alignment="CENTER">
        <HBox spacing="0" alignment="TOP_CENTER">

            <!-- Left side: L + D-pad -->
            <VBox spacing="6" alignment="TOP_CENTER">
                <ToggleButton fx:id="btnL" text="L" styleClass="ctrl-btn,ctrl-shoulder"/>
                <GridPane hgap="2" vgap="2" alignment="CENTER">
                    <ToggleButton fx:id="btnUp"    text="▲" styleClass="ctrl-btn,ctrl-dpad"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <ToggleButton fx:id="btnLeft"  text="◀" styleClass="ctrl-btn,ctrl-dpad"
                                  GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Pane prefWidth="30" prefHeight="30"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <ToggleButton fx:id="btnRight" text="▶" styleClass="ctrl-btn,ctrl-dpad"
                                  GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <ToggleButton fx:id="btnDown"  text="▼" styleClass="ctrl-btn,ctrl-dpad"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <Pane prefWidth="24"/>

            <!-- Right side: R, the ABXY diamond, and START and SELECT below, as on the DS Lite and DSi -->
            <VBox spacing="6" alignment="TOP_CENTER">
                <HBox alignment="CENTER_RIGHT">
                    <ToggleButton fx:id="btnR" text="R" styleClass="ctrl-btn,ctrl-shoulder"/>
                </HBox>
                <GridPane hgap="2" vgap="2" alignment="CENTER">
                    <ToggleButton fx:id="btnX" text="X" styleClass="ctrl-btn,ctrl-face"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <ToggleButton fx:id="btnY" text="Y" styleClass="ctrl-btn,ctrl-face"
                                  GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Pane prefWidth="30" prefHeight="30"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <ToggleButton fx:id="btnA" text="A" styleClass="ctrl-btn,ctrl-face"
                                  GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <ToggleButton fx:id="btnB" text="B" styleClass="ctrl-btn,ctrl-face"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
                <ToggleButton fx:id="btnStart" text="START" styleClass="ctrl-btn,ctrl-system">
                    <VBox.margin>
                        <Insets top="14"/>
                    </VBox.margin>
                </ToggleButton>
                <ToggleButton fx:id="btnSelect" text="SELECT" styleClass="ctrl-btn,ctrl-system"/>
            </VBox>

        </HBox>
        </HBox>

        <!-- Preview of the lines Apply adds -->
        <VBox spacing="2">
            <Label fx:id="previewNdsLabel" styleClass="text-subtle"
                   style="-fx-font-family: monospace; -fx-font-size: 0.8em;"
                   managed="false" visible="false"/>
            <Label fx:id="previewGbaLabel" styleClass="text-subtle"
                   style="-fx-font-family: monospace; -fx-font-size: 0.8em;"
                   managed="false" visible="false"/>
            <Label fx:id="previewEmptyLabel" text="No buttons selected"
                   styleClass="text-subtle" style="-fx-font-size: 0.8em;"/>
        </VBox>

        <!-- Actions -->
        <HBox spacing="8">
            <Button fx:id="applyButton" text="Apply" onAction="#handleApply"/>
            <Button fx:id="clearButton" text="Clear" onAction="#handleClear"/>
        </HBox>

    </VBox>
</TitledPane>
