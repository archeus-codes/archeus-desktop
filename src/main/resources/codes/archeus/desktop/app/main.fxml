<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="codes.archeus.desktop.app.MainController"
            styleClass="border-pane"
            onKeyPressed="#handleKeyPressed">

    <top>
        <MenuBar useSystemMenuBar="true">
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem fx:id="openMenuItem"   text="Open…"    onAction="#handleOpen"   accelerator="Shortcut+O"/>
                        <MenuItem fx:id="saveMenuItem"   text="Save"     onAction="#handleSave"   accelerator="Shortcut+S"/>
                        <MenuItem fx:id="saveAsMenuItem" text="Save As…" onAction="#handleSaveAs" accelerator="Shortcut+Shift+S"/>
                        <MenuItem fx:id="closeMenuItem"  text="Close"    onAction="#handleClose"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Exit" onAction="#handleExit"/>
                    </items>
                </Menu>
                <Menu text="Edit">
                    <items>
                        <MenuItem fx:id="addGameMenuItem"   text="Add Game"   onAction="#handleAddGame"   accelerator="Ctrl+N"/>
                        <MenuItem fx:id="addFolderMenuItem" text="Add Folder" onAction="#handleAddFolder" accelerator="Ctrl+Shift+N" disable="true"/>
                        <MenuItem fx:id="addCodeMenuItem"   text="Add Code"   onAction="#handleAddCode"   accelerator="Shortcut+D" disable="true"/>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="cutMenuItem"  text="Cut"   onAction="#handleCut"   accelerator="Shortcut+X" disable="true"/>
                        <MenuItem fx:id="copyMenuItem" text="Copy"  onAction="#handleCopy"  accelerator="Shortcut+C" disable="true"/>
                        <MenuItem fx:id="pasteMenuItem" text="Paste" onAction="#handlePaste" accelerator="Shortcut+V"/>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="deleteMenuItem" text="Delete" onAction="#handleDelete" disable="true"/>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="sortGamesAscMenuItem" text="Sort Games A → Z" onAction="#handleSortGamesAsc" disable="true"/>
                        <MenuItem fx:id="sortGamesDescMenuItem" text="Sort Games Z → A" onAction="#handleSortGamesDesc" disable="true"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Jump to Top"    onAction="#handleJumpToTop"    accelerator="Shortcut+Up"/>
                        <MenuItem text="Jump to Bottom" onAction="#handleJumpToBottom" accelerator="Shortcut+Down"/>
                    </items>
                </Menu>
                <Menu text="Tools">
                    <items>
                        <MenuItem text="Download Box Art and Icons…" onAction="#handleDownloadImages"/>
                    </items>
                </Menu>
                <Menu fx:id="themeMenu" text="Theme"/>
                <Menu text="Help">
                    <items>
                        <MenuItem text="About Archeus" onAction="#handleAbout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <center>
        <SplitPane dividerPositions="0.28">
            <VBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="4" right="6" bottom="4" left="6"/>
                    </padding>
                    <TextField fx:id="searchField" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="matchCountLabel" minWidth="40" alignment="CENTER_RIGHT"/>
                    <Button fx:id="addGameToolbarButton"/>
                </HBox>
                <TreeView fx:id="gameTree" VBox.vgrow="ALWAYS"/>
            </VBox>
            <StackPane fx:id="detailPane"/>
        </SplitPane>
    </center>

    <bottom>
        <HBox spacing="8" styleClass="status-bar">
            <padding>
                <Insets top="4" right="8" bottom="4" left="8"/>
            </padding>
            <Label fx:id="filePathLabel" text="No file open" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <ProgressBar fx:id="loadProgressBar" prefWidth="160" prefHeight="12"
                         visible="false" managed="false"/>
            <Label fx:id="gameCountLabel"/>
        </HBox>
    </bottom>

</BorderPane>
